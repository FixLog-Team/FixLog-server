DB_URL=your-db-url
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

JWT_SECRET=your-jwt-secret

# AI — 둘 다 없으면 애플리케이션이 기동되지 않는다
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key

# Mail (Gmail App Password — 일반 비밀번호 아님)
# Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호에서 생성한 16자리 코드
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
FRONTEND_URL=http://localhost:5173

# OCI Object Storage (S3 호환)
# OCI 콘솔 > Identity > Users > Customer Secret Keys 에서 발급
OCI_STORAGE_ENDPOINT=https://objectstorage.ap-chuncheon-1.oraclecloud.com
OCI_STORAGE_BUCKET=your-bucket-name
OCI_ACCESS_KEY=your-access-key
OCI_SECRET_KEY=your-secret-key
OCI_STORAGE_REGION=ap-chuncheon-1
