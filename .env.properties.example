# OAUTH2_SUCCESS_REDIRECT_URL=https://your-frontend-domain/login/callback
# SWAGGER_SERVER_URL=https://your-backend-domain/fixlog
# OAUTH2_SWAG_REDIRECT_URL=https://your-backend-domain/fixlog/login/swag/callback
